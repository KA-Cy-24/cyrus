
---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import site from '../data/site.json';
import exploration from '../data/exploration.json';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL;
const featured = (await getCollection('projects', ({ data }) => !data.draft && data.featured))
  .sort((a, b) => (a.data.featuredOrder ?? 999) - (b.data.featuredOrder ?? 999))
  .slice(0, site.featuredProjectLimit);
const allNotes = await getCollection('notebook', ({ data }) => !data.draft);
const recentNotes = allNotes
  .sort((a, b) => (b.data.updatedAt?.valueOf() ?? b.data.publishedAt?.valueOf() ?? 0) - (a.data.updatedAt?.valueOf() ?? a.data.publishedAt?.valueOf() ?? 0))
  .slice(0, site.recentNotebookLimit);
const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const allTools = await getCollection('tools', ({ data }) => !data.draft);
const withBase = (path: string) =>
  `${base.replace(/\/+$/, '')}/${path.replace(/^\/+/, '')}`;
const heroPrimary = site.heroPrimaryLink ?? { label: 'Explore projects', href: '/projects/' };
const heroSecondary = site.heroSecondaryLink ?? { label: 'Open CV.live', href: '/cv/' };
const labels = site.homeSectionMeta ?? {};
const ornaments = [
  { className: 'ornament-a', speed: 0.055, rotation: -10, scale: 1.08 },
  { className: 'ornament-b', speed: 0.09, rotation: 12, scale: 0.9 },
  { className: 'ornament-c', speed: 0.07, rotation: -18, scale: 0.96 }
];
---
<BaseLayout title={site.shortName} description={site.description} section="home">
  <div class="home-stage">
    <div class="home-ornaments" aria-hidden="true">
      {ornaments.map((ornament) => (
        <img
          src={withBase('/illustrations/protein-folding.svg')}
          alt=""
          class:list={['home-ornament', ornament.className]}
          data-home-ornament
          data-speed={ornament.speed}
          data-rotation={ornament.rotation}
          data-scale={ornament.scale}
          loading="eager"
        />
      ))}
    </div>

    <section class="home-hero home-hero-refined">
      <div class="hero-copy">
        {site.tagline && <p class="eyebrow">{site.tagline}</p>}
        <h1>{site.heroTitle}</h1>
        {site.heroSubtitle && <p class="hero-subtitle">{site.heroSubtitle}</p>}
        <p class="hero-description">{site.heroDescription}</p>
        <div class="hero-actions">
          <a class="button button-primary" href={withBase(heroPrimary.href)}>{heroPrimary.label} <span>↗</span></a>
          <a class="button button-secondary" href={withBase(heroSecondary.href)}>View CV <span>↗</span></a>
        </div>
      </div>
      <div class="hero-presence" aria-hidden="true"></div>
    </section>

    <section class="section-block featured-section">
      <div class="section-heading">
        <div>{labels.featuredEyebrow && <p class="eyebrow">{labels.featuredEyebrow}</p>}<h2>{labels.featuredTitle ?? 'Selected work'}</h2></div>
        <a class="text-link" href={withBase('/projects/')}>{labels.featuredLinkLabel ?? 'All projects'} <span>↗</span></a>
      </div>
      {featured.length ? (
        <div class="project-grid">{featured.map((entry) => <ProjectCard entry={entry} base={base} />)}</div>
      ) : (
        <div class="quiet-empty"><span class="empty-mark">01—</span><p>Featured projects will appear here as they are registered in the project collection.</p><a href={withBase('/projects/')}>Visit the project archive ↗</a></div>
      )}
    </section>

    {exploration.items.length > 0 && (
      <section class="section-block split-information" aria-labelledby="exploration-title">
        <div class="section-heading section-heading-stacked">
          {exploration.eyebrow && <p class="eyebrow">{exploration.eyebrow}</p>}
          <h2 id="exploration-title">{exploration.title}</h2>
          <p>{exploration.description}</p>
        </div>
        <ol class="exploration-list">
          {exploration.items.map(({ title, href }, index) => (
            <li><a class="exploration-link" href={href.startsWith('/') && !href.startsWith('//') ? withBase(href) : href}>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <p>{title}</p><b aria-hidden="true">↗</b>
            </a></li>
          ))}
        </ol>
      </section>
    )}

    <section class="section-block notebook-preview">
      <div class="section-heading"><div>{labels.notebookEyebrow && <p class="eyebrow">{labels.notebookEyebrow}</p>}<h2>{labels.notebookTitle ?? 'From the notebook'}</h2></div><a class="text-link" href={withBase('/notebook/')}>{labels.notebookLinkLabel ?? 'Open notebook'} <span>↗</span></a></div>
      {recentNotes.length ? (
        <div class="notebook-list">{recentNotes.map((entry) => <a class="notebook-row" href={withBase(`/notebook/${entry.data.slug ?? entry.id}/`)}><span class="notebook-date">{entry.data.category}</span><strong>{entry.data.title}</strong><span class="row-arrow">↗</span></a>)}</div>
      ) : (
        <div class="quiet-empty compact"><span class="empty-mark">N / 0</span><p>Research notes and explorations will be added here over time.</p><a href={withBase('/notebook/')}>Explore the notebook ↗</a></div>
      )}
    </section>

    <section class="home-footer-note">
      <div>{labels.archiveEyebrow && <p class="eyebrow">{labels.archiveEyebrow}</p>}<h2>{labels.archiveTitle ?? 'A website that grows with the work.'}</h2></div>
      <div class="archive-stats"><div><strong>{allProjects.length.toString().padStart(2,'0')}</strong><span>Projects</span></div><div><strong>{allTools.length.toString().padStart(2,'0')}</strong><span>Tools</span></div><div><strong>{allNotes.length.toString().padStart(2,'0')}</strong><span>Notes</span></div></div>
    </section>
  </div>
</BaseLayout>
<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ornaments = Array.from(
    document.querySelectorAll<HTMLImageElement>('[data-home-ornament]')
  );
  if (ornaments.length && !prefersReducedMotion) {
    const updateOrnaments = () => {
      const viewportHeight = window.innerHeight;
      const scrollY = window.scrollY;
      ornaments.forEach((el) => {
        const speed = Number(el.dataset.speed || 0.06);
        const rotation = Number(el.dataset.rotation || 0);
        const scale = Number(el.dataset.scale || 1);
        const rect = el.getBoundingClientRect();
        const documentTop = rect.top + scrollY;
        const distance = scrollY + viewportHeight - documentTop;
        const visibility = Math.max(0, Math.min(1, distance / (viewportHeight * 1.25)));
        const y = Math.max(-40, Math.min(80, (scrollY - documentTop) * speed));
        const dynamicScale = scale + visibility * 0.04;
        el.style.opacity = String(0.05 + visibility * 0.16);
        el.style.transform = `translate3d(0, ${y}px, 0) rotate(${rotation + visibility * 3}deg) scale(${dynamicScale})`;
      });
    };
    let frame: number | null = null;
    const requestUpdate = () => {
      if (frame !== null) cancelAnimationFrame(frame);
      frame = requestAnimationFrame(updateOrnaments);
    };
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
    requestUpdate();
  }
</script>
