---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Page not found" description="The requested page could not be found." section="home" noIndex={true}>
  <section class="page-intro error-page">
    <p class="eyebrow">404 / NOT FOUND</p>
    <h1>This page<br /><em>isn't here.</em></h1>
    <p class="page-lede">The address may have changed, or the page may not have been published yet.</p>
    <a class="button button-primary" href={base}>Return home ↗</a>
  </section>
</BaseLayout>
